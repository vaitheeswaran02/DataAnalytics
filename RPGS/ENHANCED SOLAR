<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enhanced Solar & Photovoltaic Simulation</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: rgba(18, 26, 43, 0.88);
      --border: rgba(255, 255, 255, 0.12);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --solar-gold: #fbbf24;
      --voltage-color: #34d399;
      --power-color: #f43f5e;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      user-select: none;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
    }

    .container {
      width: 100%;
      max-width: 1180px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    header h1 {
      font-size: 1.6rem;
      font-weight: 800;
      background: linear-gradient(90deg, #fcd34d, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hint {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.05);
      padding: 6px 12px;
      border-radius: 20px;
      border: 1px solid var(--border);
    }

    /* Simulation Canvas */
    .viewport-card {
      position: relative;
      width: 100%;
      height: 440px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
      border: 1px solid var(--border);
      background: #000;
    }

    canvas#simCanvas {
      width: 100%;
      height: 100%;
      display: block;
      cursor: grab;
    }

    canvas#simCanvas:active {
      cursor: grabbing;
    }

    /* Telemetry HUD Grid */
    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 18px;
      backdrop-filter: blur(12px);
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: relative;
      overflow: hidden;
    }

    .stat-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
    }

    .stat-card.v-card::after { background: var(--voltage-color); }
    .stat-card.p-card::after { background: var(--power-color); }
    .stat-card.i-card::after { background: var(--solar-gold); }
    .stat-card.rad-card::after { background: var(--accent); }

    .stat-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }

    .stat-value {
      font-size: 1.65rem;
      font-weight: 800;
      font-feature-settings: "tnum";
      font-variant-numeric: tabular-nums;
    }

    .stat-value.voltage { color: var(--voltage-color); }
    .stat-value.power { color: var(--power-color); }
    .stat-value.current { color: var(--solar-gold); }
    .stat-value.irradiance { color: var(--accent); }

    /* Dashboard Layout: Left controls, right live graph */
    .dashboard-split {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 16px;
    }

    @media (max-width: 860px) {
      .dashboard-split {
        grid-template-columns: 1fr;
      }
    }

    .panel-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px 20px;
      backdrop-filter: blur(12px);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .control-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .control-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .control-header span:last-child {
      color: var(--accent);
      font-family: monospace;
    }

    input[type="range"] {
      appearance: none;
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      background: #1e293b;
      border-radius: 4px;
      outline: none;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.7);
    }

    .btn-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    button {
      background: #1e293b;
      border: 1px solid var(--border);
      color: #fff;
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.8rem;
      transition: all 0.2s ease;
    }

    button:hover {
      background: #334155;
    }

    button.active {
      background: #0284c7;
      border-color: #38bdf8;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
    }

    /* Live Scope Canvas */
    .graph-container {
      position: relative;
      width: 100%;
      height: 180px;
      border-radius: 8px;
      background: #070a12;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    canvas#graphCanvas {
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>PV Solar & Sun Tracker Simulator</h1>
      <span class="hint">Tip: Drag the Sun or Clouds directly on the canvas!</span>
    </header>

    <!-- Main Viewport -->
    <div class="viewport-card">
      <canvas id="simCanvas"></canvas>
    </div>

    <!-- Live Telemetry -->
    <div class="telemetry-grid">
      <div class="stat-card v-card">
        <span class="stat-title">Generated Voltage</span>
        <span class="stat-value voltage" id="voltageDisplay">0.00 V</span>
      </div>
      <div class="stat-card i-card">
        <span class="stat-title">Generated Current</span>
        <span class="stat-value current" id="currentDisplay">0.00 A</span>
      </div>
      <div class="stat-card p-card">
        <span class="stat-title">Power Output</span>
        <span class="stat-value power" id="powerDisplay">0.00 W</span>
      </div>
      <div class="stat-card rad-card">
        <span class="stat-title">Solar Irradiance</span>
        <span class="stat-value irradiance" id="irradianceDisplay">0 W/m²</span>
      </div>
    </div>

    <!-- Controls & Real-Time Graph -->
    <div class="dashboard-split">
      <div class="panel-card">
        <!-- Sun Elevation Control -->
        <div class="control-group">
          <div class="control-header">
            <span>Sun Position (Angle)</span>
            <span id="sunAngleVal">55°</span>
          </div>
          <input type="range" id="sunAngleSlider" min="0" max="180" value="55" step="0.5" />
          <div class="btn-wrap">
            <button id="autoSunBtn">Auto Sun Orbit: OFF</button>
            <button id="cloudMoveBtn" class="active">Wind Motion: ON</button>
          </div>
        </div>

        <!-- Cloud Density -->
        <div class="control-group">
          <div class="control-header">
            <span>Cloud Density</span>
            <span id="cloudDensityVal">35%</span>
          </div>
          <input type="range" id="cloudDensitySlider" min="0" max="100" value="35" />
        </div>

        <!-- Panel Tilt -->
        <div class="control-group">
          <div class="control-header">
            <span>Panel Tilt</span>
            <span id="panelTiltVal">35°</span>
          </div>
          <input type="range" id="panelTiltSlider" min="0" max="90" value="35" />
        </div>

        <!-- Quick Weather Presets -->
        <div class="control-group">
          <div class="control-header"><span>Weather Presets</span></div>
          <div class="btn-wrap">
            <button onclick="setWeather(0)">Clear Sky</button>
            <button onclick="setWeather(35)">Partly Cloudy</button>
            <button onclick="setWeather(75)">Overcast</button>
            <button onclick="setWeather(98)">Storm</button>
          </div>
        </div>
      </div>

      <!-- Real-Time Graph Section -->
      <div class="panel-card">
        <div class="control-header">
          <span>Real-time Telemetry Oscillogram</span>
          <span style="font-size:0.75rem; color:#94a3b8;">
            <span style="color:var(--voltage-color)">― V</span> &nbsp;
            <span style="color:var(--power-color)">― W</span> &nbsp;
            <span style="color:var(--accent)">― G</span>
          </span>
        </div>
        <div class="graph-container">
          <canvas id="graphCanvas"></canvas>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
          <strong>Dynamic Physics:</strong> Real-time Lambert Cosine law calculations for angle of incidence, ray-casting cloud absorption, and non-linear logarithmic $P\text{-}V$ silicon diode saturation.
        </div>
      </div>
    </div>
  </div>

  <script>
    const simCanvas = document.getElementById('simCanvas');
    const sCtx = simCanvas.getContext('2d');
    const graphCanvas = document.getElementById('graphCanvas');
    const gCtx = graphCanvas.getContext('2d');

    // UI elements
    const sunAngleSlider = document.getElementById('sunAngleSlider');
    const sunAngleVal = document.getElementById('sunAngleVal');
    const autoSunBtn = document.getElementById('autoSunBtn');
    const cloudDensitySlider = document.getElementById('cloudDensitySlider');
    const cloudDensityVal = document.getElementById('cloudDensityVal');
    const cloudMoveBtn = document.getElementById('cloudMoveBtn');
    const panelTiltSlider = document.getElementById('panelTiltSlider');
    const panelTiltVal = document.getElementById('panelTiltVal');

    const voltageDisplay = document.getElementById('voltageDisplay');
    const currentDisplay = document.getElementById('currentDisplay');
    const powerDisplay = document.getElementById('powerDisplay');
    const irradianceDisplay = document.getElementById('irradianceDisplay');

    // Simulation Constants & States
    const MAX_VOLTAGE = 24.8;
    const MAX_CURRENT = 9.2;
    const MAX_IRRADIANCE = 1000;

    let sunAngle = 55;
    let autoSun = false;
    let cloudCoverage = 35;
    let moveClouds = true;
    let panelTilt = 35;

    // Smoothed values for realistic electrical damping
    let smoothV = 0, smoothI = 0, smoothP = 0, smoothG = 0;

    // Stars background
    const stars = Array.from({ length: 60 }, () => ({
      x: Math.random(),
      y: Math.random() * 0.7,
      size: Math.random() * 1.5 + 0.5,
      alpha: Math.random()
    }));

    // Moving Clouds
    const clouds = [
      { x: 120, y: 70, scale: 1.2, speed: 0.45, w: 140, h: 50 },
      { x: 420, y: 115, scale: 0.85, speed: 0.3, w: 100, h: 40 },
      { x: 720, y: 60, scale: 1.4, speed: 0.5, w: 160, h: 55 },
      { x: 1020, y: 95, scale: 1.0, speed: 0.38, w: 120, h: 45 }
    ];

    // Photons animation
    const photons = [];
    for (let i = 0; i < 40; i++) {
      photons.push({
        progress: Math.random(),
        speed: 0.01 + Math.random() * 0.015,
        offset: (Math.random() - 0.5) * 50
      });
    }

    // Historical Graph Buffer
    const historyData = [];
    const maxHistoryPoints = 120;

    function resizeCanvases() {
      const sRect = simCanvas.getBoundingClientRect();
      simCanvas.width = sRect.width * window.devicePixelRatio;
      simCanvas.height = sRect.height * window.devicePixelRatio;
      sCtx.scale(window.devicePixelRatio, window.devicePixelRatio);

      const gRect = graphCanvas.getBoundingClientRect();
      graphCanvas.width = gRect.width * window.devicePixelRatio;
      graphCanvas.height = gRect.height * window.devicePixelRatio;
      gCtx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    window.addEventListener('resize', resizeCanvases);
    resizeCanvases();

    // Event Listeners
    sunAngleSlider.addEventListener('input', (e) => {
      sunAngle = parseFloat(e.target.value);
      sunAngleVal.textContent = `${Math.round(sunAngle)}°`;
    });

    cloudDensitySlider.addEventListener('input', (e) => {
      cloudCoverage = parseFloat(e.target.value);
      cloudDensityVal.textContent = `${Math.round(cloudCoverage)}%`;
    });

    panelTiltSlider.addEventListener('input', (e) => {
      panelTilt = parseFloat(e.target.value);
      panelTiltVal.textContent = `${Math.round(panelTilt)}°`;
    });

    autoSunBtn.addEventListener('click', () => {
      autoSun = !autoSun;
      autoSunBtn.textContent = `Auto Sun Orbit: ${autoSun ? 'ON' : 'OFF'}`;
      autoSunBtn.classList.toggle('active', autoSun);
    });

    cloudMoveBtn.addEventListener('click', () => {
      moveClouds = !moveClouds;
      cloudMoveBtn.textContent = `Wind Motion: ${moveClouds ? 'ON' : 'OFF'}`;
      cloudMoveBtn.classList.toggle('active', moveClouds);
    });

    window.setWeather = function(val) {
      cloudCoverage = val;
      cloudDensitySlider.value = val;
      cloudDensityVal.textContent = `${val}%`;
    };

    // Canvas Direct Drag Handling
    let isDraggingSun = false;
    let draggedCloud = null;

    function getCanvasCoords(e) {
      const rect = simCanvas.getBoundingClientRect();
      return {
        x: (e.clientX || (e.touches && e.touches[0].clientX)) - rect.left,
        y: (e.clientY || (e.touches && e.touches[0].clientY)) - rect.top
      };
    }

    function startDrag(e) {
      const { x, y } = getCanvasCoords(e);
      const w = simCanvas.width / window.devicePixelRatio;
      const h = simCanvas.height / window.devicePixelRatio;

      // Sun coordinates
      const sunRad = (sunAngle * Math.PI) / 180;
      const sunX = (w / 2) - (w * 0.44) * Math.cos(sunRad);
      const sunY = (h * 0.88) - (h * 0.68) * Math.sin(sunRad);

      if (Math.hypot(x - sunX, y - sunY) < 45) {
        isDraggingSun = true;
        return;
      }

      // Cloud hit test
      for (let c of clouds) {
        const cx = (c.x % (w + 200)) - 100;
        if (Math.abs(x - cx) < c.w * 0.7 && Math.abs(y - c.y) < c.h * 0.8) {
          draggedCloud = { cloud: c, offsetX: x - c.x, offsetY: y - c.y };
          return;
        }
      }
    }

    function onDrag(e) {
      if (!isDraggingSun && !draggedCloud) return;
      const { x, y } = getCanvasCoords(e);
      const w = simCanvas.width / window.devicePixelRatio;
      const h = simCanvas.height / window.devicePixelRatio;

      if (isDraggingSun) {
        const dx = (w / 2) - x;
        let deg = (Math.atan2(h * 0.88 - y, dx) * 180) / Math.PI;
        deg = Math.max(0, Math.min(180, 180 - deg));
        sunAngle = deg;
        sunAngleSlider.value = sunAngle;
        sunAngleVal.textContent = `${Math.round(sunAngle)}°`;
      } else if (draggedCloud) {
        draggedCloud.cloud.x = x - draggedCloud.offsetX;
        draggedCloud.cloud.y = Math.max(30, Math.min(h * 0.5, y - draggedCloud.offsetY));
      }
    }

    function endDrag() {
      isDraggingSun = false;
      draggedCloud = null;
    }

    simCanvas.addEventListener('mousedown', startDrag);
    window.addEventListener('mousemove', onDrag);
    window.addEventListener('mouseup', endDrag);

    simCanvas.addEventListener('touchstart', startDrag, { passive: true });
    window.addEventListener('touchmove', onDrag, { passive: true });
    window.addEventListener('touchend', endDrag);

    // Draw Realistic Cloud
    function renderVolumetricCloud(ctx, x, y, scale, density) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);

      const alpha = (density / 100);
      const isDarkStorm = density > 70;

      const baseColor = isDarkStorm ? 70 : 255;
      ctx.fillStyle = `rgba(${baseColor}, ${baseColor}, ${baseColor + (isDarkStorm ? 10 : 0)}, ${alpha * 0.92})`;
      ctx.shadowColor = `rgba(0,0,0,${alpha * 0.35})`;
      ctx.shadowBlur = 16;

      const puffs = [
        { dx: -35, dy: 10, r: 25 },
        { dx: -15, dy: -12, r: 32 },
        { dx: 15, dy: -8, r: 28 },
        { dx: 35, dy: 8, r: 22 },
        { dx: 0, dy: 14, r: 24 }
      ];

      puffs.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.dx, p.dy, p.r, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.restore();
    }

    // Main Simulation & Physics Calculation
    function computeSolarMetrics(sunX, sunY, panelX, panelY, w) {
      const sunRad = (sunAngle * Math.PI) / 180;
      const panelRad = ((90 - panelTilt) * Math.PI) / 180;
      const incidentAngle = Math.abs(sunRad - panelRad);
      
      let geometricFactor = Math.cos(incidentAngle);
      if (sunAngle <= 0 || sunAngle >= 180 || geometricFactor < 0) {
        geometricFactor = 0;
      }

      // Cloud Ray-Intersection
      let cloudShadow = 0;
      const effDensity = cloudCoverage / 100;

      clouds.forEach(c => {
        const cx = (c.x % (w + 200)) - 100;
        const cy = c.y;

        const dx = panelX - sunX;
        const dy = panelY - sunY;
        const lenSq = dx * dx + dy * dy;
        const t = Math.max(0, Math.min(1, ((cx - sunX) * dx + (cy - sunY) * dy) / lenSq));
        const projX = sunX + t * dx;
        const projY = sunY + t * dy;
        const dist = Math.hypot(cx - projX, cy - projY);

        if (dist < 75 * c.scale) {
          const overlap = 1 - dist / (75 * c.scale);
          cloudShadow = Math.min(1, cloudShadow + overlap * effDensity);
        }
      });

      const clearSkyFactor = Math.max(0.04, 1 - cloudShadow * 0.88);
      const irradiance = MAX_IRRADIANCE * geometricFactor * clearSkyFactor;

      let voltage = 0;
      let current = 0;
      let power = 0;

      if (irradiance > 1) {
        const normG = irradiance / MAX_IRRADIANCE;
        voltage = MAX_VOLTAGE * (0.78 + 0.22 * Math.log10(1 + 9 * normG));
        current = MAX_CURRENT * normG;
        power = voltage * current;
      }

      return { voltage, current, power, irradiance, cloudShadow };
    }

    let wirePulseOffset = 0;

    // Simulation Render Loop
    function render() {
      const w = simCanvas.width / window.devicePixelRatio;
      const h = simCanvas.height / window.devicePixelRatio;

      // 1. Sun Auto Progression
      if (autoSun) {
        sunAngle = (sunAngle + 0.18) % 180;
        sunAngleSlider.value = sunAngle;
        sunAngleVal.textContent = `${Math.round(sunAngle)}°`;
      }

      // 2. Dynamic Sky Color Interpolation
      const sunRatio = Math.sin((sunAngle * Math.PI) / 180);
      const sky = sCtx.createLinearGradient(0, 0, 0, h);
      
      if (sunRatio > 0.4) {
        sky.addColorStop(0, '#0284c7');
        sky.addColorStop(0.65, '#38bdf8');
        sky.addColorStop(1, '#bae6fd');
      } else if (sunRatio > 0.05) {
        sky.addColorStop(0, '#0f172a');
        sky.addColorStop(0.45, '#7c2d12');
        sky.addColorStop(0.8, '#ea580c');
        sky.addColorStop(1, '#fde047');
      } else {
        sky.addColorStop(0, '#020617');
        sky.addColorStop(0.8, '#0f172a');
        sky.addColorStop(1, '#1e1b4b');
      }
      sCtx.fillStyle = sky;
      sCtx.fillRect(0, 0, w, h);

      // Stars (visible at night / low sun)
      if (sunRatio < 0.25) {
        const starAlpha = (1 - sunRatio / 0.25);
        stars.forEach(st => {
          sCtx.fillStyle = `rgba(255, 255, 255, ${starAlpha * (0.4 + Math.sin(Date.now() * 0.003 + st.alpha) * 0.3)})`;
          sCtx.beginPath();
          sCtx.arc(st.x * w, st.y * h, st.size, 0, Math.PI * 2);
          sCtx.fill();
        });
      }

      // 3. Sun Calculations
      const sunRad = (sunAngle * Math.PI) / 180;
      const sunX = (w / 2) - (w * 0.44) * Math.cos(sunRad);
      const sunY = (h * 0.88) - (h * 0.68) * Math.sin(sunRad);
      const panelX = w / 2;
      const panelY = h * 0.78;

      const raw = computeSolarMetrics(sunX, sunY, panelX, panelY, w);

      // Damping / Smooth readings
      smoothV += (raw.voltage - smoothV) * 0.1;
      smoothI += (raw.current - smoothI) * 0.1;
      smoothP += (raw.power - smoothP) * 0.1;
      smoothG += (raw.irradiance - smoothG) * 0.1;

      voltageDisplay.textContent = `${smoothV.toFixed(2)} V`;
      currentDisplay.textContent = `${smoothI.toFixed(2)} A`;
      powerDisplay.textContent = `${smoothP.toFixed(1)} W`;
      irradianceDisplay.textContent = `${Math.round(smoothG)} W/m²`;

      // 4. Sun & Photon Beam
      if (sunAngle > 0 && sunAngle < 180) {
        // Corona glow
        const glow = sCtx.createRadialGradient(sunX, sunY, 15, sunX, sunY, 80);
        glow.addColorStop(0, 'rgba(254, 240, 138, 0.9)');
        glow.addColorStop(0.35, 'rgba(251, 191, 36, 0.5)');
        glow.addColorStop(1, 'rgba(245, 158, 11, 0)');
        sCtx.fillStyle = glow;
        sCtx.beginPath();
        sCtx.arc(sunX, sunY, 80, 0, Math.PI * 2);
        sCtx.fill();

        // Sun disc
        sCtx.fillStyle = '#ffffff';
        sCtx.beginPath();
        sCtx.arc(sunX, sunY, 22, 0, Math.PI * 2);
        sCtx.fill();

        // Photon Stream Animation
        if (smoothG > 20) {
          const photonAlpha = Math.min(0.6, smoothG / MAX_IRRADIANCE);
          sCtx.strokeStyle = `rgba(255, 235, 130, ${photonAlpha})`;
          sCtx.fillStyle = `rgba(255, 255, 200, ${photonAlpha})`;

          photons.forEach(pt => {
            pt.progress = (pt.progress + pt.speed) % 1;
            const px = sunX + (panelX - sunX) * pt.progress + pt.offset * (1 - pt.progress);
            const py = sunY + (panelY - 15 - sunY) * pt.progress;
            sCtx.beginPath();
            sCtx.arc(px, py, 2.5, 0, Math.PI * 2);
            sCtx.fill();
          });
        }
      }

      // 5. Render Clouds
      clouds.forEach(c => {
        if (moveClouds) c.x += c.speed;
        const cx = (c.x % (w + 200)) - 100;
        renderVolumetricCloud(sCtx, cx, c.y, c.scale, cloudCoverage);
      });

      // 6. Ground & Dynamic Terrain Shadow
      const groundGrad = sCtx.createLinearGradient(0, h * 0.78, 0, h);
      groundGrad.addColorStop(0, '#15803d');
      groundGrad.addColorStop(1, '#052e16');
      sCtx.fillStyle = groundGrad;
      sCtx.fillRect(0, h * 0.78, w, h * 0.22);

      // Panel Ground Shadow (Length depends on sun elevation)
      const shadowLength = (panelX - sunX) * 0.45;
      sCtx.fillStyle = 'rgba(0, 0, 0, 0.35)';
      sCtx.beginPath();
      sCtx.ellipse(panelX + shadowLength * 0.5, h * 0.85, Math.abs(shadowLength) + 50, 10, 0, 0, Math.PI * 2);
      sCtx.fill();

      // 7. Wiring & Electrical Current Flow
      sCtx.strokeStyle = '#1e293b';
      sCtx.lineWidth = 4;
      sCtx.beginPath();
      sCtx.moveTo(panelX, panelY + 25);
      sCtx.lineTo(panelX + 70, panelY + 50);
      sCtx.lineTo(panelX + 160, panelY + 50);
      sCtx.stroke();

      if (smoothI > 0.1) {
        wirePulseOffset = (wirePulseOffset + smoothI * 0.8) % 16;
        sCtx.strokeStyle = '#34d399';
        sCtx.lineWidth = 2.5;
        sCtx.setLineDash([6, 10]);
        sCtx.lineDashOffset = -wirePulseOffset;
        sCtx.beginPath();
        sCtx.moveTo(panelX, panelY + 25);
        sCtx.lineTo(panelX + 70, panelY + 50);
        sCtx.lineTo(panelX + 160, panelY + 50);
        sCtx.stroke();
        sCtx.setLineDash([]);
      }

      // 8. Solar Panel Mount & 3D Glass Layer
      sCtx.save();
      sCtx.translate(panelX, panelY);

      // Metal Stand
      sCtx.strokeStyle = '#64748b';
      sCtx.lineWidth = 6;
      sCtx.beginPath();
      sCtx.moveTo(0, 0);
      sCtx.lineTo(0, 32);
      sCtx.lineTo(-30, 32);
      sCtx.lineTo(30, 32);
      sCtx.stroke();

      // Tilting Matrix
      const tiltRad = ((panelTilt - 45) * Math.PI) / 180;
      sCtx.rotate(tiltRad);

      // Metallic Panel Bezel
      sCtx.fillStyle = '#94a3b8';
      sCtx.fillRect(-75, -12, 150, 24);

      // PV Cells Silicon Plate
      sCtx.fillStyle = smoothV > 12 ? '#1e3a8a' : '#091326';
      sCtx.fillRect(-71, -9, 142, 18);

      // Silicon Grid Busbars
      sCtx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
      sCtx.lineWidth = 1;
      for (let gx = -55; gx <= 55; gx += 22) {
        sCtx.beginPath();
        sCtx.moveTo(gx, -9);
        sCtx.lineTo(gx, 9);
        sCtx.stroke();
      }

      // Specular Sunlight Glare Reflection on Glass
      if (smoothG > 200) {
        const sheen = sCtx.createLinearGradient(-60, 0, 60, 0);
        sheen.addColorStop(0, 'rgba(255, 255, 255, 0)');
        sheen.addColorStop(0.5, 'rgba(255, 255, 255, 0.45)');
        sheen.addColorStop(1, 'rgba(255, 255, 255, 0)');
        sCtx.fillStyle = sheen;
        sCtx.fillRect(-71, -9, 142, 18);
      }

      sCtx.restore();

      // 9. Update Oscillogram Data
      if (historyData.length > maxHistoryPoints) historyData.shift();
      historyData.push({
        v: smoothV / MAX_VOLTAGE,
        p: smoothP / (MAX_VOLTAGE * MAX_CURRENT),
        g: smoothG / MAX_IRRADIANCE
      });

      renderGraph();
      requestAnimationFrame(render);
    }

    // Oscilloscope Graph Rendering
    function renderGraph() {
      const gw = graphCanvas.width / window.devicePixelRatio;
      const gh = graphCanvas.height / window.devicePixelRatio;

      gCtx.clearRect(0, 0, gw, gh);

      // Grid Lines
      gCtx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
      gCtx.lineWidth = 1;
      for (let y = 0.25; y < 1; y += 0.25) {
        gCtx.beginPath();
        gCtx.moveTo(0, gh * y);
        gCtx.lineTo(gw, gh * y);
        gCtx.stroke();
      }

      function drawTrace(key, color) {
        gCtx.strokeStyle = color;
        gCtx.lineWidth = 2;
        gCtx.beginPath();
        historyData.forEach((d, idx) => {
          const gx = (idx / (maxHistoryPoints - 1)) * gw;
          const gy = gh - d[key] * (gh - 12) - 6;
          if (idx === 0) gCtx.moveTo(gx, gy);
          else gCtx.lineTo(gx, gy);
        });
        gCtx.stroke();
      }

      drawTrace('g', '#38bdf8'); // Irradiance
      drawTrace('p', '#f43f5e'); // Power
      drawTrace('v', '#34d399'); // Voltage
    }

    requestAnimationFrame(render);
  </script>
</body>
</html>
